{
    "name": "test/car-ad-service",
    "description": "REST API сервис для управления объявлениями автомобилей (PHP8, Yii2, PostgreSQL)",
    "type": "project",
    "keywords": ["yii2", "framework", "rest", "api"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "yiisoft/yii2": "~2.0.51",
        "yiisoft/yii2-swiftmailer": "~2.1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.1",
        "phpunit/phpunit": "^9.6",
        "yiisoft/yii2-debug": "~2.1.0"
    },
    "config": {
        "process-timeout": 1800,
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "yiisoft/yii2-debug": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    }
}
